<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\game-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TyperShroom.Core\TyperShroom.Core.csproj" />
    <ProjectReference Include="..\TyperShroom.Data\TyperShroom.Data.csproj" />
  </ItemGroup>

<Target Name="BuildContent" BeforeTargets="Build">
  <Exec Command="mgcb Content/Content.mgcb" WorkingDirectory="$(MSBuildProjectDirectory)" />
  <ItemGroup>
    <XnbFiles Include="Content/bin/Content/**/*.xnb" />
    <RawContentFiles Include="Content/bin/Content/**/*" Exclude="Content/bin/Content/**/*.xnb" />
  </ItemGroup>
  <Copy SourceFiles="@(XnbFiles)" DestinationFiles="@(XnbFiles->'$(OutputPath)/Content/%(RecursiveDir)%(Filename)%(Extension)')" />
  <Copy SourceFiles="@(RawContentFiles)" DestinationFiles="@(RawContentFiles->'$(OutputPath)/Content/%(RecursiveDir)%(Filename)%(Extension)')" />
</Target>

<Target Name="PublishContent" AfterTargets="Publish">
  <ItemGroup>
    <XnbFiles Include="Content/bin/Content/**/*.xnb" />
    <RawContentFiles Include="Content/bin/Content/**/*" Exclude="Content/bin/Content/**/*.xnb" />
  </ItemGroup>
  <Copy SourceFiles="@(XnbFiles)" DestinationFiles="@(XnbFiles->'$(PublishDir)/Content/%(RecursiveDir)%(Filename)%(Extension)')" />
  <Copy SourceFiles="@(RawContentFiles)" DestinationFiles="@(RawContentFiles->'$(PublishDir)/Content/%(RecursiveDir)%(Filename)%(Extension)')" />
</Target>

</Project>
